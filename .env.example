# Postgres (local: docker compose up -d)
# En Vercel + Neon: DATABASE_URL apunta al pooler y DIRECT_URL a la conexión directa (migraciones)
DATABASE_URL="postgresql://lavadero:lavadero@localhost:5432/lavadero"
DIRECT_URL="postgresql://lavadero:lavadero@localhost:5432/lavadero"

# Auth.js — generar con: npx auth secret  (o: openssl rand -base64 32)
AUTH_SECRET="cambiar-por-un-secreto-real"
